# Build artifacts and generated files
/target/
/build/
/obj/
/dist/
/inst/
/dl/
/vendor/

# Large source subtrees excluded from indexing. NOTE: src/triton is
# intentionally NOT ignored here so its sources are searchable/editable
# (a blanket /src/ would re-block it, since an ignored parent cannot be
# selectively re-included).
/src/llvm-project/
/src/gcc/
/src/melior/
/src/bootstrap/
/src/tools/
/src/doc/

# Triton third-party dependencies (large, less relevant)
/src/triton/third_party/

# Test artifacts and benchmarks
/src/tools/rustc-perf/collector/compile-benchmarks/
*.pyc
__pycache__/
*.py[cod]

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*~
.#*
\#*

# Cache directories
.cache/
.citool-cache/
.bv/

# Generated tags
tags
tags.*
TAGS
TAGS.*

# Node modules (if any)
node_modules/

# Rust build artifacts (already in .gitignore but explicit here)
**/target/
**/Cargo.lock

# Large generated documentation
/src/doc/

# Beads local files
.bv/
todo.md
context.md
